# Environment variables for the Spark Streaming Project
# Copy this file to .env and adjust values as needed.

# Jupyter authentication token
JUPYTER_TOKEN=change_me_to_a_secure_token

# Kafka advertised listener (use your Docker network IP or hostname)
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092

# Spark version used across services
SPARK_VERSION=3.3.0

# Zookeeper - set to "no" in production
ALLOW_ANONYMOUS_LOGIN=yes

# Kafka - set to "no" in production
ALLOW_PLAINTEXT_LISTENER=yes
